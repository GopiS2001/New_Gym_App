{
  "expo": {
    "name": "FitFlow",
    "slug": "gym-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.premiumgym.fitflow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1520",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.premiumgym.fitflow"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1520",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8F135"
        }
      ],
      "expo-video"
    ],
    "scheme": "fitflow",
    "backgroundColor": "#0B1520",
    "experiments": {
      "typedRoutes": false
    },
    "owner": "gopis2001",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "23a30dbe-9a46-4315-975a-c4c12d2510c8"
      }
    }
  }
}
